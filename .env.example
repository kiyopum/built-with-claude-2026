# このファイルは見本です。本物の値は .env に書きます（.env は GitHub に上げません）。
# 値はすべて空にしてあります。必要なものだけ埋めてください。

# Claude（必須）
ANTHROPIC_API_KEY=

# Stripe はテストモードのキーだけ（sk_test_ / whsec_。本番キー sk_live_ は受け付けません）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 売れたときのメール（どちらかが空なら送らず、画面の知らせだけ）
SMTP_URL=
MAIL_FROM=

# データ（SQLite・写真・録音）を置く場所。空なら ./data
YAOBIZ_DATA_DIR=

# サーバーに置くとき：最初の管理者を作るリンクの合言葉（NODE_ENV=production では必須）
YAOBIZ_SETUP_KEY=

# サーバーに置くとき：外から見たアドレス（決済の戻り先・メールのリンクに使う。例 https://example.com）
APP_BASE_URL=

# Claude を1日に呼べる回数の上限（空なら 400）
CLAUDE_DAILY_LIMIT=
